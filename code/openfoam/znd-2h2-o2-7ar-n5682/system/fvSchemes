FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}

// Gate B1 retains Kurganov as the regression baseline.
// Supported: Kurganov, Tadmor, HLL.
fluxScheme      Kurganov;

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         cellLimited Gauss linear 0.7;
}

divSchemes
{
    default         Gauss linear;
    div(phi,Yi_h)   Gauss limitedLinear 1;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default             linear;

    // OF14 shockFluid reconstruction keys. rhoU uses the U key and
    // rPsi/c/e use the T key in detonationFluid.
    reconstruct(rho)    vanLeer;
    reconstruct(U)      vanLeerV;
    reconstruct(T)      vanLeer;
}

snGradSchemes
{
    default         corrected;
}

